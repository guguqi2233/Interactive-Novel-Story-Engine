APP_NAME="Local LLM Interactive Novel World Engine"
APP_ENV="local"

# SQLite save database. Local db files are ignored by git. Save archives may
# contain hidden runtime state by design; treat them as private local backups.
DATABASE_URL="sqlite:///./world_engine.db"

# LLM provider selection. Supported values: mock, local_stub, local_http, openai.
# Keep mock for local development/tests unless you intentionally call a real provider.
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4.1-mini"
# Local prompt profile id. Profiles only adjust prompt style/variants and
# generation preferences; they do not change visibility or GameState authority.
# v1.1 RP prompt profile settings live inside prompt profile data; they do not
# need API keys and must keep hidden_fact_policy/state_modification_policy denied.
PROMPT_PROFILE_ID="default_safe"
# Required only when LLM_PROVIDER=openai.
LLM_API_KEY=""
# v2.5 ProviderProfileV2 examples should reference env names rather than raw
# keys. Use OPENAI_API_KEY or RELAY_API_KEY as api_key_env values in local
# provider profiles; keep these blank in committed files.
OPENAI_API_KEY=""
RELAY_API_KEY=""

# Local model provider settings.
# local_stub is deterministic and does not call any service.
# local_http posts to LOCAL_LLM_BASE_URL/chat/completions using an OpenAI-compatible
# request/response shape. Keep LLM_PROVIDER=mock unless you intentionally call it.
LOCAL_LLM_BASE_URL=""
LOCAL_LLM_MODEL="local-model"
LOCAL_LLM_TIMEOUT_SECONDS="30"
LOCAL_LLM_JSON_MODE="true"

# Local-only event timeline and v1.3 NPC Simulation Debugger API.
# Keep true for trusted local development. Set false before exposing the backend outside localhost.
# Enables debug NPC simulation summary/detail, dry-run tick, tick event list,
# and NPC behavior timeline. Debug output is not player UI and may include
# redacted hidden ids or local diagnostic details.
ENABLE_DEBUG_API="true"

# Local-only content pack authoring and v1.4 content production APIs. Disabled by default for safety.
# Enables v1.2 Visual Authoring Pro tools: visual editors, Template Wizard,
# Character Pack Builder, Local Content Library, Reference Picker, Draft History,
# Merge Assistant, Diff Review, and package import/export.
# Also gates v1.4 World Pack Wizard, NPC/Quest Pack Generators, Location /
# Mystery / Faction Templates, Batch Validator, Coverage Planner, Local Content
# Library Pro, Batch Character/Lorebook Import, Script Package Builder,
# Campaign Starter Kit Builder, Production Pipeline Dashboard, and Batch
# Quality Gate API routes.
# Enable only when editing worlds on a trusted local machine.
ENABLE_AUTHORING_API="false"

# Local-only lightweight performance sampling.
# Samples stay in process memory and do not include prompts, API keys, raw GameState, or raw deltas.
ENABLE_PERF_LOGGING="false"

# Local-only v1.5 model usage tracking.
# Records safe token estimates, latency, error type, provider/model ids, and use-case labels only.
# It never stores raw prompts, API keys, hidden fact text, raw GameState, or raw StateDelta data.
ENABLE_USAGE_TRACKING="false"

# v1.5 Prompt Lab API note:
# There is currently no separate ENABLE_PROMPT_LAB_API setting. Prompt Lab
# benchmark/context/routing/compatibility/style endpoints reuse the local
# benchmark gate (ENABLE_DEBUG_API, ENABLE_PERF_LOGGING, or ENABLE_USAGE_TRACKING).
# Usage endpoints require ENABLE_DEBUG_API or ENABLE_USAGE_TRACKING.
# Keep real-provider runs disabled unless you explicitly pass allow_real_provider
# or allow_real_local_check in a trusted local session.
# ENABLE_PROMPT_LAB_API=""

# Local-only automated playtesting API, including v1.3 NPC simulation regression playtests.
# Agents use the game loop/test harness with mock/local_stub providers and do not act as player AI.
ENABLE_PLAYTEST_API="false"

# Local-only narrative/eval API. Evals use deterministic fixtures by default and do not call real LLMs.
# v1.3 NPC simulation quality checks are deterministic and are also consumed by
# the Quality Gate / World Health report path.
ENABLE_EVAL_API="false"

# v1.3 NPC simulation and v1.4 content production have no separate
# provider/network setting. NPC simulation is deterministic rule code.
# v1.4 generators default to deterministic draft/package generation; reserved
# llm_assisted schema fields are not real-provider call paths in the current
# implementation.

# v1.6 gameplay modules are local declarative modules. The current backend
# default module root is gameplay_modules/. Tests may override app.state
# directly. Keep module packages local; imports reject zip slip, executables,
# API keys, .env, databases, logs, caches, and unsafe permissions.
# MODULE_ROOT is documented here for local scripts and future settings
# integration; current runtime defaults to gameplay_modules when unset.
MODULE_ROOT="gameplay_modules"

# v0.9-v1.6 quality APIs currently reuse the local debug/eval/playtest/perf/
# authoring gates where implemented. There is no separate ENABLE_QUALITY_API
# setting yet.
# Keep the backend bound to localhost; do not expose quality analyzers as a hosted service.
# ENABLE_QUALITY_API=""

# Optional local authoring roots. Current backend defaults are worlds/, mods/,
# templates/, and imports/. Keep them local and never point them at sensitive
# folders such as home directories, source-control roots outside this project,
# .env locations, databases, or system paths.
AUTHORING_ROOT="worlds"
MODS_ROOT="mods"
TEMPLATE_ROOT="templates"
PACKAGE_IMPORT_ROOT="imports"
# Optional documentation placeholder for future library-specific roots. The
# current Local Content Library Pro derives local roots from the import/export
# service and repository defaults rather than this value.
CONTENT_LIBRARY_ROOT=""

# v1.7 Desktop Studio local paths.
# Current runtime defaults use the repository/current workspace, local logs/,
# and policy-level backup/export checks. These placeholders are for local
# scripts/future settings integration and must never contain secrets.
# The frontend must not receive these values as VITE_* variables.
WORKSPACE_ROOT=""
LOG_DIR="logs"
BACKUP_DIR="backups"

# v2.1 NarrativeProject note:
# NarrativeProject workspaces are local authoring/studio data under a safe
# project root. The current ProjectRepository defaults to ./projects when the
# backend has no injected repository. There is no required v2.1 secret setting.
# Use ENABLE_AUTHORING_API=true only on a trusted local machine to create/open
# projects from the Project Shell. Project files must not contain raw API keys;
# provider profiles may reference api_key_env names only.
# NARRATIVE_PROJECT_ROOT=""

# v2.2 Novel Studio MVP note:
# Novel Studio uses the same local authoring gate as NarrativeProject. There is
# no separate ENABLE_NOVEL_API setting and no required real provider key.
# Keep LLM_PROVIDER=mock/local_stub for tests. Optional draft generation must
# use provider profiles that reference api_key_env names only; do not store real
# keys in project.yaml, Novel files, exports, prompts, frontend env, or logs.
# Novel exports are local Markdown/TXT drafts and must not contain .env data,
# provider secrets, debug memory, raw state_deltas, or authoring-private notes.
# ENABLE_NOVEL_API=""

# v2.3 Tavern Studio MVP note:
# Tavern Studio uses the same local authoring gate as NarrativeProject. There is
# no separate ENABLE_TAVERN_API setting and no required real provider key.
# Keep LLM_PROVIDER=mock/local_stub for tests. Optional Tavern response
# generation must use LLMProvider / Provider Gateway and must not store real
# keys in project.yaml, Tavern files, RP profiles, prompt profiles, frontend env,
# logs, or exports. Tavern sessions/messages/memory/proposals are local RP data
# and never directly modify GameState or EventLog.
# ENABLE_TAVERN_API=""

# v2.4 Cross-Mode Bridge note:
# Cross-Mode Bridge uses the same local authoring gate as NarrativeProject.
# There is no required real provider key and no separate runtime secret.
# Keep LLM_PROVIDER=mock/local_stub for tests. Cross-mode drafts, proposals,
# reviews, apply plans, validation reports, audit records, timeline views,
# import/export, and quality-gate checks must not contain .env data, API keys,
# provider secrets, raw debug memory, raw state_deltas, or raw env. World apply
# paths require validation, explicit confirmation, StateDelta, and EventLog.
# ENABLE_CROSS_MODE_API=""

# v2.5 Provider Gateway Pro note:
# Provider profile APIs use the local authoring/studio boundary and return safe
# summaries only. Profiles may reference api_key_env / secret_ref but must not
# store raw API keys. Usage tracking is local metadata only and does not upload
# telemetry or store full prompts/outputs.
# There is currently no separate ENABLE_PROVIDER_API setting; provider profile
# management uses ENABLE_AUTHORING_API, and usage summaries use ENABLE_DEBUG_API
# or ENABLE_USAGE_TRACKING.
# ENABLE_PROVIDER_API=""

# v2.6 Script / Mod Platform Pro note:
# Module Browser, package validation, mod quality gate, permission dashboard,
# compatibility, certification, and mod audit APIs use the local authoring
# boundary and return safe summaries only. Extension packages are declarative
# local data; they must not execute code, read secrets, or directly modify
# GameState. There is currently no separate ENABLE_MODULE_API / ENABLE_MOD_API
# setting; use ENABLE_AUTHORING_API=true only on a trusted local machine.
# ENABLE_MODULE_API=""
# ENABLE_MOD_API=""

# v2.7 Advanced World Simulation Modules note:
# Advanced module authoring/dashboard endpoints are local-only and should be
# enabled only on a trusted machine. Module rules are deterministic and must
# not call real providers or execute plugin code. ENABLE_MODULE_API is an
# optional placeholder listed above; current local authoring surfaces still
# primarily use ENABLE_AUTHORING_API.

# v2.8 Roleplay Immersion & Mature Module note:
# Mature Module is local-only and disabled by default. It is not an online
# adult-content service, age verification service, cloud sync feature, NSFW
# image generator, or arbitrary-code plugin runtime. RP safety evals and
# Mature/RP Quality Gate checks are deterministic local checks and must not call
# real providers. Keep mature export disabled unless explicitly configured in a
# trusted local project policy.
ENABLE_MATURE_MODULE="false"
ENABLE_RP_SAFETY_EVAL="true"

# Memory backend note:
# Current engine implements in-memory and SQLite memory stores, plus a local-vector-ready fallback interface.
# There is no mandatory external vector service. This value is documentation/configuration only unless
# a future runtime factory wires it in.
MEMORY_BACKEND="sqlite"

# Frontend-only variable used by Vite/React.
# Put this in frontend/.env.local or your shell when running the frontend.
# Never expose LLM_API_KEY or provider credentials as VITE_* variables.
VITE_API_BASE_URL="http://127.0.0.1:8000"
