APP_NAME="Local LLM Interactive Novel World Engine"
APP_ENV="local"

# SQLite save database. Local db files are ignored by git.
DATABASE_URL="sqlite:///./world_engine.db"

# LLM provider selection. Supported values: mock, openai.
# Keep mock for local development/tests unless you intentionally call a real provider.
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4.1-mini"
# Required only when LLM_PROVIDER=openai.
LLM_API_KEY=""

# Local-only event timeline API for development debugging.
# Keep true for local development. Set false before exposing the backend outside localhost.
ENABLE_DEBUG_API="true"

# Local-only content pack authoring API. Disabled by default for safety.
# Enable only when editing worlds on a trusted local machine.
ENABLE_AUTHORING_API="false"

# Optional local authoring roots. Current backend defaults are worlds/ and mods/.
# If future wiring reads these directly, keep them local and never point at sensitive folders.
AUTHORING_ROOT="worlds"
MODS_ROOT="mods"

# Memory backend note:
# v0.5 implements in-memory and SQLite memory stores, plus a local-vector-ready fallback interface.
# There is no mandatory external vector service. This value is documentation/configuration only unless
# a future runtime factory wires it in.
MEMORY_BACKEND="sqlite"

# Frontend-only variable used by Vite/React.
# Put this in frontend/.env.local or your shell when running the frontend.
VITE_API_BASE_URL="http://127.0.0.1:8000"
